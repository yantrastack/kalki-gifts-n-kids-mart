# Local development uses a SQLite file (no account needed).
DATABASE_URL="file:local.db"
DATABASE_AUTH_TOKEN=""

# To use Turso cloud instead, comment the lines above and set:
# DATABASE_URL="libsql://your-db-name.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"

# Secret used to sign session JWTs (change in production)
SESSION_SECRET="dev-stockwell-secret-change-me-in-production-0xA1B2C3"

# Product media (images + videos).
# Leave Cloudinary vars EMPTY to store uploads on local disk (dev default).
# For production, use Cloudinary's free tier (25 GB storage + 25 GB/mo bandwidth,
# images + video, CDN). See docs/MEDIA.md. Two ways to configure — pick one:
#
#   A) Signed uploads (recommended if you have API credentials):
#      set Cloud name + API key + API secret from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
#
#   B) Unsigned uploads (no secret on the server):
#      set Cloud name + an *unsigned* upload preset (Settings → Upload → presets).
# CLOUDINARY_UPLOAD_PRESET=""
#
# Optional: folder to organize assets (default "stockwell")
CLOUDINARY_FOLDER="stockwell"
